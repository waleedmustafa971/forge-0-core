# FORGE-0 configuration. Copy to `.env` (git-ignored) and adjust.
# Secrets belong only in `.env` / your secret manager — never in code or commits.

# --- Runtime ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

# PostgreSQL from `docker compose up -d db` (host port 5433)
DATABASE_URL=postgresql+psycopg://forge:forge@127.0.0.1:5433/forge0
POSTGRES_PASSWORD=forge
DATA_DIR=data

# --- Local authentication ------------------------------------------------------
# local (localhost dev, no token) | token
AUTH_MODE=local
FORGE_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider ------------------------------------------------------------------
# mock  : deterministic scripted fixtures, no network (default; works without credentials)
# meta  : Meta Model API (Muse Spark) — requires META_API_KEY
# openai: any OpenAI-compatible endpoint
AI_PROVIDER=mock
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_TIMEOUT_S=180
# List prices used for cost estimates (USD per 1M tokens; Muse Spark 1.3 standard mode)
AI_PRICE_INPUT_PER_M=1.25
AI_PRICE_OUTPUT_PER_M=4.25
# Cached prompt tokens (prompt_tokens_details.cached_tokens)
AI_PRICE_CACHED_INPUT_PER_M=0.15

# Meta Model API (https://dev.meta.ai/docs). MODEL_API_KEY is also accepted.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# empty | minimal | low | medium | high | xhigh
META_REASONING_EFFORT=
# json_schema | json_object | none
META_STRUCTURED_OUTPUT=json_schema

# OpenAI-compatible endpoint (e.g. a local Ollama / vLLM server)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL=llama3.1
OPENAI_COMPAT_STRUCTURED_OUTPUT=json_object

# --- Sandbox -------------------------------------------------------------------------
# auto: `docker` on PATH, else `wsl -- docker` on Windows. Or set e.g. "wsl -d Ubuntu -- docker".
SANDBOX_DOCKER_COMMAND=auto
SANDBOX_NODE_IMAGE=node:24-alpine
SANDBOX_PYTHON_IMAGE=forge0/sandbox-python:3.12
SANDBOX_CPUS=1.0
SANDBOX_MEMORY=512m
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_S=60
SANDBOX_WORKDIR_SIZE=256m

# --- Investigation budgets ------------------------------------------------------------------
MAX_EXPERIMENTS=8
MAX_MODEL_CALLS=24
MAX_REPAIR_ATTEMPTS=3
MAX_EXPERIMENT_ROUNDS=3
INVESTIGATION_TIME_BUDGET_S=900
WORKER_THREADS=2
KEEP_WORKSPACES=false

# --- Repository import ---------------------------------------------------------------------
# Extra comma-separated directories that local imports may read from (demo/ is always allowed).
IMPORT_ALLOWED_ROOTS=
SEED_DEMO=true
